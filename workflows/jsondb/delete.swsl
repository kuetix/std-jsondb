// Module name derived from filename: delete
// Remove the document (and its indexes, if any) stored under $args.id.

import services/common

def services/common/errors.OnAnyError(msg: "jsondb delete failed", statusCode: 500) as errorHandler -> .

jsondb/document.Delete(
    path: $args.path??"",
    collection: $args.collection,
    id: $args.id
) as result <- errorHandler ->
services/common/response.Response(value: $result, statusCode: 200) -> .
